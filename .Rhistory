install.packages("zoo")
# Chunk 1: setup
#| label: setup
source('https://inkaverse.com/setup.r')
# Chunk 2
gs <- "https://docs.google.com/spreadsheets/d/1cNoexwoni9u8OxOOeWBAZIlYe6dcXQ4yPVuuHt_pOsU/edit?gid=0#gid=0" %>%
as_sheets_id()
fb <- gs %>%
range_read(ss = ., sheet = "fb") %>%
mutate(
variedades = factor(variedades),
rep = factor(rep),
planta = factor(planta)
)
str(fb)
# Research Objectives
> https://docs.google.com/spreadsheets/d/1u6xgTT8jDFkHSMkK1iRrNVR-1iOINQidbEiaDCu2Nqw/edit?gid=504037395#gid=504037395
# Chunk 1: setup
#| label: setup
source('https://inkaverse.com/setup.r')
# Chunk 2
gs <- "https://docs.google.com/spreadsheets/d/1cNoexwoni9u8OxOOeWBAZIlYe6dcXQ4yPVuuHt_pOsU/edit?gid=0#gid=0" %>%
as_sheets_id()
fb <- gs %>%
range_read(ss = ., sheet = "fb") %>%
mutate(
variedades = factor(variedades),
rep = factor(rep),
planta = factor(planta)
)
str(fb)
# Chunk 3
library(tidyverse)
ggplot(fb, aes(x = variedades, y = severidad)) +
geom_boxplot() +
labs(
x = "Variedad",
y = "Severidad"
) +
theme_classic()
# Chunk 4
av <- aov(severidad ~ variedades, fb)
anova(av)
mc <-  emmeans(av, ~ variedades) %>%
cld(Letters = letters)
mc
ggplot(letras, aes(x = variedades, y = emmean)) +
geom_col() +
geom_text(
aes(y = emmean + 2, label = .group),
size = 5
) +
labs(
x = "Variedad",
y = "Severidad"
) +
theme_classic()
ggplot(mc, aes(x = variedades, y = emmean)) +
geom_col() +
geom_text(
aes(label = .group),
vjust = -0.5,
size = 5
) +
scale_y_continuous(
limits = c(0, 30),
breaks = seq(0, 30, 5),
expand = expansion(mult = c(0, 0.08))
) +
labs(
x = "Variedades",
y = "Severidad"
) +
theme_classic()
ggplot(mc, aes(x = variedades, y = emmean)) +
geom_col(aes(fill = variedades)) +
geom_text(
aes(label = .group),
vjust = -0.5,
size = 5
) +
scale_y_continuous(
limits = c(0, 30),
breaks = seq(0, 30, 5),
expand = expansion(mult = c(0, 0.08))
) +
labs(
x = "Variedades",
y = "Severidad",
fill = "Variedades"
) +
theme_classic()
plot(av)
inti:::tarpuy_full()
