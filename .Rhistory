gs <- "https://docs.google.com/spreadsheets/d/1bEwz2UM9MGXKwOIfFgEAKHt0jfx-M0-GIYKu9ujxCjI/edit?usp=sharing" %>%
as_sheets_id()
fb <- gs %>%
range_read(sheet = "fb") %>%
mutate(
topofisis = factor(topofisis),
dosis_root_hor = factor(dosis_root_hor),
ntreat = factor(ntreat),
