str(fb)
library(tidyverse)
library(car)
library(emmeans)
datos_vivas %>%
dplyr::select(
plots,
ntreat,
topofisis,
dosis_root_hor,
rep,
estacas_vivas
)
View(datos_vivas)
View(datos_vivas)
# Número de estacas vivas a los 60 días
datos_vivas <- fb %>%
rowwise() %>%
mutate(
estacas_vivas = sum(
c_across(matches("^estado_60_[0-9]+$")) == "V",
na.rm = TRUE
)
) %>%
ungroup()
View(datos_vivas)
# ANOVA factorial
modelo_vivas <- aov(
estacas_vivas ~ topofisis * dosis_root_hor,
data = datos_vivas
)
summary(modelo_vivas)
supervivencia <- fb %>%
rowwise() %>%
mutate(
vivas_15 = sum(c_across(matches("^estado_15_[0-9]+$")) == "V"),
vivas_30 = sum(c_across(matches("^estado_30_[0-9]+$")) == "V"),
vivas_45 = sum(c_across(matches("^estado_45_[0-9]+$")) == "V"),
vivas_60 = sum(c_across(matches("^estado_60_[0-9]+$")) == "V")
) %>%
ungroup() %>%
dplyr::select(
ntreat,
topofisis,
dosis_root_hor,
rep,
vivas_15,
vivas_30,
vivas_45,
vivas_60
) %>%
pivot_longer(
cols = starts_with("vivas_"),
names_to = "dia",
values_to = "estacas_vivas"
) %>%
mutate(
dia = as.numeric(gsub("vivas_", "", dia))
)
View(supervivencia)
supervivencia_media <- supervivencia %>%
group_by(
ntreat,
topofisis,
dosis_root_hor,
dia
) %>%
summarise(
media_vivas = mean(estacas_vivas),
.groups = "drop"
) %>%
mutate(
tratamiento = paste0("T", ntreat)
)
supervivencia_media
View(supervivencia_media)
ggplot(
supervivencia_media,
aes(
x = dia,
y = media_vivas,
group = tratamiento,
color = tratamiento
)
) +
geom_line(linewidth = 0.8) +
geom_point(size = 2.5) +
scale_x_continuous(
breaks = c(15, 30, 45, 60)
) +
scale_y_continuous(
limits = c(0, 10),
breaks = seq(0, 10, 2)
) +
labs(
title = "Supervivencia de las estacas según el tiempo",
x = "Días",
y = "Estacas vivas",
color = "Tratamiento"
) +
theme_classic()
# Datos de supervivencia a los 60 días
datos_vivas <- fb %>%
rowwise() %>%
mutate(
estacas_vivas = sum(
c_across(matches("^estado_60_[0-9]+$")) == "V"
)
) %>%
ungroup()
# ANOVA factorial
modelo_vivas <- aov(
estacas_vivas ~ dosis_root_hor * topofisis,
data = datos_vivas
)
summary(modelo_vivas)
library(emmeans)
# Medias ajustadas para topófisis
emm_topofisis <- emmeans(
modelo_vivas,
~ topofisis
)
emm_topofisis
# Comparaciones múltiples de Tukey
pairs(
emm_topofisis,
adjust = "tukey"
)
emm_interaccion <- emmeans(
modelo_vivas,
~ topofisis * dosis_root_hor
)
emm_interaccion
emm_df <- as.data.frame(emm_interaccion)
emm_df
# Grafico
library(ggplot2)
ggplot(
emm_df,
aes(
x = topofisis,
y = emmean,
group = dosis_root_hor,
color = dosis_root_hor
)
) +
geom_line(linewidth = 0.8) +
geom_point(size = 3) +
geom_errorbar(
aes(
ymin = lower.CL,
ymax = upper.CL
),
width = 0.1
) +
labs(
title = "Número de estacas vivas a los 60 días",
x = "Topófisis",
y = "Número de estacas vivas",
color = "Dosis de Root Hor"
) +
theme_classic()
